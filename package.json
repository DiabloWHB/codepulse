{
  "name": "codepulse-ai",
  "displayName": "CodePulse AI",
  "description": "Real-time code health monitoring with dependency tracking for AI-assisted development",
  "version": "0.2.0",
  "publisher": "DiabloWHB",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "code health",
    "dependency graph",
    "impact analysis",
    "ai",
    "vibe coding",
    "supabase",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DiabloWHB/codepulse.git"
  },
  "bugs": {
    "url": "https://github.com/DiabloWHB/codepulse/issues"
  },
  "homepage": "https://github.com/DiabloWHB/codepulse#readme",
  "main": "./dist/extension.js",
  "bin": {
    "codepulse-mcp": "./dist/mcp/index.js"
  },
  "activationEvents": [
    "workspaceContains:**/*.ts",
    "workspaceContains:**/*.tsx",
    "workspaceContains:**/*.js",
    "workspaceContains:**/*.jsx"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codepulse.analyzeFile",
        "title": "CodePulse: Analyze Current File",
        "icon": "$(file-code)"
      },
      {
        "command": "codepulse.analyzeWorkspace",
        "title": "CodePulse: Analyze Workspace",
        "icon": "$(folder-opened)"
      },
      {
        "command": "codepulse.showDashboard",
        "title": "CodePulse: Show Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "codepulse.showImpact",
        "title": "CodePulse: Show Impact Analysis",
        "icon": "$(graph)"
      },
      {
        "command": "codepulse.showDependencies",
        "title": "CodePulse: Show Dependencies",
        "icon": "$(references)"
      },
      {
        "command": "codepulse.refresh",
        "title": "CodePulse: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "codepulse.showProjectReport",
        "title": "CodePulse: Show Project Report",
        "icon": "$(file-text)"
      },
      {
        "command": "codepulse.searchSymbol",
        "title": "CodePulse: Search Symbol",
        "icon": "$(search)"
      },
      {
        "command": "codepulse.rebuildIndex",
        "title": "CodePulse: Rebuild Symbol Index",
        "icon": "$(database)"
      },
      {
        "command": "codepulse.showIndexStats",
        "title": "CodePulse: Show Index Statistics",
        "icon": "$(graph-line)"
      },
      {
        "command": "codepulse.getSymbolContext",
        "title": "CodePulse: Get Symbol Context (AI)",
        "icon": "$(lightbulb)"
      },
      {
        "command": "codepulse.getAIContext",
        "title": "CodePulse: Get AI Context (Internal)",
        "icon": "$(robot)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codepulse",
          "title": "CodePulse",
          "icon": "resources/icons/codepulse.svg"
        }
      ]
    },
    "views": {
      "codepulse": [
        {
          "id": "codepulse.quickAccessView",
          "name": "Quick Actions"
        },
        {
          "id": "codepulse.healthView",
          "name": "Health Status"
        },
        {
          "id": "codepulse.impactView",
          "name": "Impact Analysis"
        },
        {
          "id": "codepulse.detailsView",
          "name": "Details",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "CodePulse",
      "properties": {
        "codepulse.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable CodePulse"
        },
        "codepulse.debounceDelay": {
          "type": "number",
          "default": 300,
          "description": "Debounce delay for file changes (ms)"
        },
        "codepulse.supabase.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Supabase integration"
        },
        "codepulse.graph.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable dependency graph building"
        },
        "codepulse.graph.maxDepth": {
          "type": "number",
          "default": 5,
          "description": "Maximum depth for impact analysis"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "codepulse.analyzeFile",
          "when": "view == codepulse.healthView",
          "group": "navigation@1"
        },
        {
          "command": "codepulse.analyzeWorkspace",
          "when": "view == codepulse.healthView",
          "group": "navigation@2"
        },
        {
          "command": "codepulse.refresh",
          "when": "view == codepulse.healthView",
          "group": "navigation@3"
        },
        {
          "command": "codepulse.showProjectReport",
          "when": "view == codepulse.healthView",
          "group": "navigation@4"
        },
        {
          "command": "codepulse.showDashboard",
          "when": "view == codepulse.impactView",
          "group": "navigation@1"
        },
        {
          "command": "codepulse.showImpact",
          "when": "view == codepulse.impactView",
          "group": "navigation@2"
        },
        {
          "command": "codepulse.showDependencies",
          "when": "view == codepulse.impactView",
          "group": "navigation@3"
        },
        {
          "command": "codepulse.searchSymbol",
          "when": "view == codepulse.quickAccessView",
          "group": "navigation@1"
        },
        {
          "command": "codepulse.showIndexStats",
          "when": "view == codepulse.quickAccessView",
          "group": "navigation@2"
        },
        {
          "command": "codepulse.rebuildIndex",
          "when": "view == codepulse.quickAccessView",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "codepulse.getSymbolContext",
          "when": "editorTextFocus && resourceLangId =~ /typescript|javascript/",
          "group": "codepulse@1"
        },
        {
          "command": "codepulse.searchSymbol",
          "when": "editorTextFocus",
          "group": "codepulse@2"
        }
      ],
      "commandPalette": [
        {
          "command": "codepulse.getAIContext",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build && npm run build:mcp",
    "build": "node esbuild.js --production",
    "build:mcp": "tsc -p tsconfig.mcp.json",
    "watch": "node esbuild.js --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "dotenv": "16.3.1",
    "glob": "10.3.10",
    "minimatch": "9.0.3",
    "tree-sitter": "0.21.1",
    "tree-sitter-typescript": "0.23.2"
  },
  "devDependencies": {
    "@types/minimatch": "5.1.2",
    "@types/node": "18.19.0",
    "@types/vscode": "1.85.0",
    "@typescript-eslint/eslint-plugin": "6.18.0",
    "@typescript-eslint/parser": "6.18.0",
    "@vitest/coverage-v8": "1.2.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "2.22.0",
    "electron-rebuild": "^3.2.9",
    "esbuild": "0.19.11",
    "eslint": "8.56.0",
    "prettier": "3.2.0",
    "typescript": "5.3.3",
    "vitest": "1.2.0"
  }
}
